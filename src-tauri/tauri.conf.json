{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HaexVault",
  "version": "0.1.0",
  "identifier": "com.haex.holzi",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "HaexVault",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost 'self' http://127.0.0.1:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: holzi-ext://localhost http://holzi-ext.localhost http://127.0.0.1:*",
        "frame-src": "holzi-ext://localhost http://holzi-ext.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "media-src": "'self' http://127.0.0.1:*"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3030",
        "connect-src": "ipc: http://ipc.localhost 'self' http://localhost:3030 ws://localhost:3030 http://127.0.0.1:*",
        "font-src": "'self' data: http://localhost:3030",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:3030 holzi-ext://localhost http://holzi-ext.localhost http://127.0.0.1:*",
        "frame-src": "holzi-ext://localhost http://holzi-ext.localhost",
        "script-src": "'self' 'unsafe-eval' http://localhost:3030",
        "style-src": "'self' 'unsafe-inline' http://localhost:3030",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "media-src": "'self' http://127.0.0.1:*"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["haex-vault"] },
      "mobile": [{ "scheme": ["haex-vault"], "host": "contact" }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
