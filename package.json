{
  "name": "holzi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "check:chat-state": "node --test scripts/check-chat-state.ts scripts/check-chat-navigation.ts scripts/check-chat-live-data.ts scripts/check-chat-tool-notice.ts scripts/check-chat-tool-text.ts",
    "check:wm-navigation": "node --test scripts/check-wm-navigation.ts scripts/check-wm-actions.ts scripts/check-wm-app-match.ts scripts/check-wm-nav-store.ts scripts/check-wm-keys.ts",
    "check:agent-actions": "node --test scripts/check-agent-actions.ts",
    "check:wm-state": "node --test scripts/check-wm-state.ts scripts/check-wm-focus.ts scripts/check-wm-geometry.ts scripts/check-wm-persistence.ts scripts/check-wm-session.ts scripts/check-wm-dock.ts scripts/check-wm-background.ts",
    "check:settings": "node --test scripts/check-settings.ts",
    "check:vault-data": "node --test scripts/check-vault-data.ts",
    "check:passwords": "node --test scripts/check-passwords-*.ts",
    "check:storage": "node --test scripts/check-storage-*.ts",
    "check:fields": "node --test scripts/check-fields.ts",
    "check:appearance": "node --test scripts/check-appearance*.ts",
    "check:extensions": "node --test scripts/check-extensions-*.ts",
    "check:chat-model-search": "node --test scripts/check-chat-model-search.ts",
    "check:vault-lifecycle": "node scripts/check-vault-lifecycle.ts",
    "check:vault-passphrase-lifetime": "node scripts/check-vault-passphrase-lifetime.ts",
    "check:templates": "node scripts/check-vue-templates.ts",
    "check:android-versions": "node --test scripts/check-android-versions.ts",
    "check:e2e-exclusions": "node --test scripts/check-e2e-exclusions.ts",
    "check:files": "node --test scripts/check-files-*.ts",
    "check:platform-probe": "node --test scripts/check-platform-probe.ts",
    "check:e2e-lib": "node --test scripts/e2e/lib/*.test.ts scripts/e2e/lib/platform/*.test.ts",
    "test:e2e": "scripts/with-nix-host-bridge.sh node scripts/e2e/cli.ts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "scripts/with-nix-host-bridge.sh cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && scripts/with-nix-host-bridge.sh cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --all-targets -- -D warnings",
    "lint:all": "pnpm lint && pnpm lint:rust",
    "tauri": "tauri",
    "tauri:dev": "scripts/with-nix-host-bridge.sh tauri dev",
    "tauri:dev:cuda": "scripts/with-nix-host-bridge.sh tauri dev -- --features llm-cuda",
    "tauri:dev:metal": "tauri dev -- --features llm-metal",
    "tauri:build": "scripts/with-nix-host-bridge.sh tauri build",
    "tauri:build:cuda": "scripts/with-nix-host-bridge.sh tauri build -- --features llm-cuda",
    "tauri:build:metal": "tauri build -- --features llm-metal",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "export:eval-tools": "node scripts/export-eval-tools.ts",
    "generate:ts-types": "scripts/with-nix-host-bridge.sh cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --nocapture && sed -i -E 's/[[:space:]]+$//' src/types/bindings/*.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.52.0",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "embla-carousel-vue": "^8.6.0",
    "fuse.js": "^7.5.0",
    "marked": "^18.1.0",
    "nuxt": "4.5.2",
    "pdfjs-dist": "^6.4",
    "photoswipe": "^5.4",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "swiper": "^14",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.140",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
